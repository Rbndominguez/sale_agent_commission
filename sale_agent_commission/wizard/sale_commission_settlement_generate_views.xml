<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_settlement_generate_view_form" model="ir.ui.view">
        <field name="name">sale.commission.settlement.generate.form</field>
        <field name="model">sale.commission.settlement.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Commission Settlements">
                <group>
                    <group>
                        <field name="agent_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="commission_base"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="candidate_count"/>
                        <field name="estimated_amount"/>
                    </group>
                </group>
                <notebook>
                    <page string="Orders to settle">
                        <field name="candidate_order_ids" readonly="1">
                            <list create="false" delete="false">
                                <field name="name"/>
                                <field name="date_order"/>
                                <field name="partner_id"/>
                                <field name="agent_id"/>
                                <field name="amount_untaxed"/>
                                <field name="margin"/>
                                <field name="commission_rate"/>
                                <field name="commission_amount"/>
                                <field name="commission_amount_margin"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate" class="btn-primary"
                            invisible="candidate_count == 0"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_commission_settlement_generate_action" model="ir.actions.act_window">
        <field name="name">Generate Commission Settlements</field>
        <field name="res_model">sale.commission.settlement.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_manager'))]"/>
    </record>

    <menuitem id="sale_commission_settlement_generate_menu"
              name="Generate Settlements"
              parent="sale.menu_sale_config"
              action="sale_commission_settlement_generate_action"
              groups="sales_team.group_sale_manager"
              sequence="91"/>

</odoo>