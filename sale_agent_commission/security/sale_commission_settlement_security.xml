<odoo>

<record id="sale_commission_settlement_rule_own" model="ir.rule">
    <field name="name">Settlement: own agent only</field>
    <field name="model_id" ref="model_sale_commission_settlement"/>
    <field name="domain_force">[("agent_id", "=", user.id)]</field>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
</record>

<record id="sale_commission_settlement_rule_manager" model="ir.rule">
    <field name="name">Settlement: manager sees all</field>
    <field name="model_id" ref="model_sale_commission_settlement"/>
    <field name="domain_force">[(1, "=", 1)]</field>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
</record>

<record id="sale_commission_settlement_line_rule_own" model="ir.rule">
    <field name="name">Settlement line: own agent only</field>
    <field name="model_id" ref="model_sale_commission_settlement_line"/>
    <field name="domain_force">[("settlement_id.agent_id", "=", user.id)]</field>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
</record>

<record id="sale_commission_settlement_line_rule_manager" model="ir.rule">
    <field name="name">Settlement line: manager sees all</field>
    <field name="model_id" ref="model_sale_commission_settlement_line"/>
    <field name="domain_force">[(1, "=", 1)]</field>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
</record>

</odoo>